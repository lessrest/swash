#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  printf '\n==> %s\n' "$1"
}

step "Checking system packages"
packages=(build-essential ca-certificates curl systemd)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
else
  echo "System packages are already installed"
fi

step "Checking Go 1.25.5"
go_version="go1.25.5"
if [[ "$(command -v go >/dev/null 2>&1 && go version | awk '{print $3}')" != "$go_version" ]]; then
  if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "Unsupported orb architecture: $(uname -m)" >&2
    exit 1
  fi

  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://go.dev/dl/${go_version}.linux-amd64.tar.gz" -o "$archive"
  echo "9e9b755d63b36acf30c12a9a3fc379243714c1c6d3dd72861da637f336ebb35b  $archive" | sha256sum -c -
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "$archive"
  sudo ln -sf /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
  rm -f "$archive"
  trap - EXIT
else
  go version
fi

step "Downloading Go dependencies"
GOWORK=off go mod download
(
  cd vterm
  GOWORK=off go mod download
)

step "Orb setup complete"
