#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_image=/nix.img
nix_mount=/nix

step() {
  printf '\n==> %s\n' "$1"
}

step "Enabling the systemd user manager"
sudo loginctl enable-linger "$(id -un)"
sudo systemctl start "user@$(id -u).service"

step "Mounting the persistent Nix store"
if [[ ! -e "$nix_image" ]]; then
  sudo truncate -s 32G "$nix_image"
  sudo mkfs.ext4 -F "$nix_image"
fi
sudo mkdir -p "$nix_mount"
fstab_entry="$nix_image $nix_mount ext4 loop,noatime,nofail 0 0"
if ! grep -Fqx "$fstab_entry" /etc/fstab; then
  printf '%s\n' "$fstab_entry" | sudo tee -a /etc/fstab >/dev/null
fi
if ! mountpoint -q "$nix_mount"; then
  sudo mount "$nix_mount"
fi

step "Installing Nix"
if [[ ! -x /nix/var/nix/profiles/default/bin/nix ]]; then
  curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
fi

# Determinate Nix includes this file from its generated nix.conf.
sudo mkdir -p /etc/nix
sudo touch /etc/nix/nix.custom.conf
sudo sed -i '/^auto-optimise-store[[:space:]]*=/d' /etc/nix/nix.custom.conf
echo 'auto-optimise-store = false' | sudo tee -a /etc/nix/nix.custom.conf >/dev/null
sudo rm -rf /nix/store/.links
sudo systemctl start nix-daemon.socket

profile_line='source /etc/profile.d/nix.sh'
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_line" "$HOME/.bash_profile"; then
  printf '%s\n' "$profile_line" >> "$HOME/.bash_profile"
fi

# shellcheck source=/dev/null
source /etc/profile.d/nix.sh
export PATH="/nix/var/nix/profiles/default/bin:$PATH"

step "Prewarming the development shell"
nix develop "path:$repo_root" --command true
